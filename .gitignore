# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.tmp/
/test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Capacitor generated assets and local native tooling
/mobile/dist/
/mobile/node_modules/
/android/.gradle/
/android/.idea/
/android/captures/
/android/local.properties
/android/**/build/
/android/app/src/main/assets/public/
/android/app/src/main/assets/capacitor.config.json
/android/app/src/main/assets/capacitor.plugins.json
/ios/App/App/public/
/ios/App/App/capacitor.config.json
/ios/App/Pods/
/ios/App/build/
**/DerivedData/
**/xcuserdata/
*.keystore
*.jks
key.properties
